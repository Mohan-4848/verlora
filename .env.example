# ---- Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ----
VERIFY_TOKEN=hackathon_token_123
PHONE_NUMBER_ID=
ACCESS_TOKEN=
# Optional: App Secret → verifies X-Hub-Signature-256 on incoming webhooks
APP_SECRET=
GRAPH_VERSION=v21.0

# Public URL of this server (ngrok / cloudflared). Used for UPI payment links sent to customers.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.dev

# ---- AI (free) ----
# Google AI Studio key: https://aistudio.google.com/apikey  (primary)
GEMINI_API_KEY=
# Tried in order; each model has its own free per-minute quota, so the chain absorbs rate limits
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_REASONING=low
# Optional last-resort fallback: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile

# ---- Store ----
STORE_NAME=Sri Krishna Quick Mart
STORE_UPI_ID=srikrishnamart@upi
# Optional: the shared WhatsApp number shown in each shop's "join" link (looked up from Meta if empty)
SHARED_WA_NUMBER=
